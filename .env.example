# ===========================================
# TaskFlow - Environment Variables
# Copy this file to .env.local and fill in real values
# Command: cp .env.example .env.local
# ===========================================

# MongoDB connection string.
# Local install:        mongodb://localhost:27017/taskflow
# MongoDB Atlas (cloud): mongodb+srv://<user>:<password>@<cluster-url>/taskflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/taskflow

# JWT secrets - used to sign access & refresh tokens.
# Generate strong random values with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_this_with_a_long_random_string
JWT_REFRESH_SECRET=replace_this_with_a_different_long_random_string

# Token lifetimes
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Socket.io server port (custom Node server, see server/index.js)
SOCKET_PORT=3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# File uploads (local disk for dev; swap for S3 in production)
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_MB=10
